        var notification = document.createElement("div");
        notification.classList.add("notification", type);
        notification.textContent = message;
        notification.setAttribute("data-qa", "notification");
        form.appendChild(notification);
        setTimeout(function() {
            notification.remove();
        }, 2000);
    };
